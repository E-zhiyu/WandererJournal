<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 精确闹钟设置权限 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机监听权限 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 安装APK权限 -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />
    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <!-- 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 生物验证使用权限 -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 请求忽略电池优化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 声明需要交互的应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" /> <!-- 分享文件 -->
        </intent>
    </queries>

    <application
        android:name=".WandererJournal"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WandererJournal.Static"
        tools:targetApi="33">
        <activity
            android:name=".ui.pages.main.settings.sub.DiaryAlarmActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.media.FullScreenMediaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.pages.statistics.StatisticsActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.emotion.EmotionTagInputActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.emotion.EmotionTagListActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.pages.emotion.EmotionTagListActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.main.settings.sub.AboutActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.WriteActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.DiaryReadActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.main.settings.sub.DataManageActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.main.settings.sub.PermissionManageActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.share.SharePreviewActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.DiaryReadActivity" />
        <activity
            android:name=".ui.pages.role.RoleListActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.pages.role.RoleInputActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.role.RoleListActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.pages.AuthActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.pages.main.settings.sub.ShareSettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity" />
        <activity
            android:name=".ui.pages.life_note.LifeNoteListActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.main.MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.pages.life_note.LifeNoteInputActivity"
            android:exported="false"
            android:parentActivityName=".ui.pages.life_note.LifeNoteListActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.pages.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".automation.broadcast.DiaryAlarmReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="触发检查当天是否有日记的广播接收器" /> <!-- 日记提醒广播接收器 -->
        <receiver
            android:name=".automation.broadcast.BootReceiver"
            android:enabled="true"
            android:exported="false"
            android:label="开机完毕的监听器，用于自动安排第二天0点的预算重置闹钟">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver> <!-- 开机广播接收器 -->
    </application>

</manifest>