<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.pages.media.FullScreenMediaActivity">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:transitionName="fullscreen_media" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hdr_text_card"
        style="@style/MediumRadiusCardStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="100dp"
        android:backgroundTint="@color/gray_translucent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/separator_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/HDR"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/mdtp_white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/center_btn_card"
        style="@style/MediumRadiusCardStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/gray_translucent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButtonGroup
            android:id="@+id/btn_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- 分享按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/share_media_btn"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/gray_translucent"
                android:contentDescription="@string/btn_share"
                app:icon="@drawable/outline_share_24"
                app:iconTint="@color/mdtp_white" />

            <!-- 保存按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_media_btn"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/gray_translucent"
                android:contentDescription="@string/btn_save"
                app:icon="@drawable/outline_download_24"
                app:iconTint="@color/mdtp_white" />
        </com.google.android.material.button.MaterialButtonGroup>
    </com.google.android.material.card.MaterialCardView>

    <!-- 详情按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/info_btn"
        style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="25dp"
        android:backgroundTint="@color/gray_translucent"
        app:icon="@drawable/outline_info_24"
        app:iconTint="@color/mdtp_white"
        app:layout_constraintBottom_toBottomOf="@id/center_btn_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/center_btn_card" />
</androidx.constraintlayout.widget.ConstraintLayout>